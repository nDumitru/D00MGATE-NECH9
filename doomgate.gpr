-- =============================================================
-- D00MGATE-NECH9 -- GNAT Project File
-- Author: Dumitru Nechita
-- Compile: gprbuild -P doomgate.gpr
-- Run:     ./build/doomgate_demo
-- =============================================================

project Doomgate is

   --  Where the Master_Key package comes from:
   --    keystub (default) -> public stub, key read from D00MGATE_MASTER_KEY
   --    core              -> your private core/master_key.ads/.adb (git-ignored)
   Key_Dir := external ("DOOMGATE_KEY_DIR", "keystub");

   for Source_Dirs use (".", Key_Dir);
   for Object_Dir  use "build/obj";
   for Exec_Dir    use "build";
   for Main        use ("doomgate_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use
         ("-O2",           -- Optimize
          "-gnat2012",     -- Ada 2012 standard
          "-Wall",         -- All warnings
          "-gnata",        -- Enable assertions
          "-gnatwl");      -- Elaboration warnings
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lm");
   end Linker;

   package Binder is
      for Default_Switches ("Ada") use ("-E");  -- Stack traceback
   end Binder;

end Doomgate;
